# Directories
APP_DIR=./Deep-Live-Cam_dockerized
STARTUP_SCRIPT=./docker_script.sh
MODELS_DIR=./models
OUTPUT_DIR=./output # Root output directory for all files generated by the container (e.g. processed images, videos, etc.)

# Files
SOURCE_FOLDER=./output/sources
TARGET_FOLDER=./output/targets
OUTPUT_FOLDER=./output/processed

# Processor Settings
MANY_FACES=true
FRAME_PROCESSOR=face_enhancer,face_swapper

# Performance Settings
MAX_MEM=8
THREADS=2


# Video Settings
VIDEO_ENCODER=libx265
KEEP_AUDIO=true
VIDEO_QUALITY=0
KEEP_FPS=true

# GPU
USE_GPU=true
RUNTIME=cuda
GPU_COUNT=1

# System Environment
NVIDIA_VISIBLE_DEVICES=1

# Container Settings
CONTAINER_NAME=faceswap

IMAGE_NAME=docker.io/avgradmin/deep-swap:v0.1.10-cuda-11.8

DOCKERFILE_PATH=./Dockerfile.12.2.2
